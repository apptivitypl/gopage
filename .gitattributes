# Every text file is stored and checked out with LF, on every platform. Without
# this, Git for Windows checks out CRLF, gofmt rewrites every file back to LF,
# and the format gate reports the whole module as unformatted.
* text=auto eol=lf

# Never converted.
*.woff2 binary
*.ico binary
*.png binary
*.jpg binary
*.wasm binary
*.br binary
*.gz binary
*.bin binary

# Generated by the compiler and not worth reviewing line by line.
internal/scaffold/templates/**/pnpm-lock.yaml linguist-generated=true
pnpm-lock.yaml linguist-generated=true
