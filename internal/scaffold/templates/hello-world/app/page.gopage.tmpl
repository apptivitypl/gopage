---
import "<<.Module>>/server/hackernews"

type Props struct {
	Heading string
	Lead    string
	Host    string
	Start   int
}

type Story struct {
	Title string
	URL   string
	By    string
	Score int
}

func HackerNews(ctx *gopage.Ctx) ([]Story, error) {
	top, _ := hackernews.Top(ctx.Request())
	stories := make([]Story, 0, len(top))
	for _, story := range top {
		stories = append(stories, Story{Title: story.Title, URL: story.URL, By: story.By, Score: story.Score})
	}
	return stories, nil
}

func Meta(ctx *gopage.Ctx, p Props) gopage.Meta {
	return gopage.Meta{Title: p.Heading, Description: p.Lead, Robots: "index"}
}

func Load(ctx *gopage.Ctx) (Props, error) {
	return Props{
		Heading: ctx.T("hero.title"),
		Lead:    ctx.T("hero.lead"),
		Host:    ctx.Request().Host,
		Start:   0,
	}, nil
}
