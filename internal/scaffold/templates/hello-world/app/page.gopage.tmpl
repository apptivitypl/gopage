            <div class="panel-body" data-pane="server-code"><pre class="source"><code><span class="line"><span class="ln"> 1</span><span class="tok-punct">//go:build !js</span></span><span class="line"><span class="ln"> 2</span></span><span class="line"><span class="ln"> 3</span><span class="tok-key">package</span> hackernews</span><span class="line"><span class="ln"> 4</span></span><span class="line"><span class="ln"> 5</span><span class="tok-key">import</span> (</span><span class="line"><span class="ln"> 6</span>	<span class="tok-str">"encoding/json"</span></span><span class="line"><span class="ln"> 7</span>	<span class="tok-str">"fmt"</span></span><span class="line"><span class="ln"> 8</span>	<span class="tok-str">"net/http"</span></span><span class="line"><span class="ln"> 9</span>	<span class="tok-str">"time"</span></span><span class="line"><span class="ln">10</span>)</span><span class="line"><span class="ln">11</span></span><span class="line"><span class="ln">12</span><span class="tok-key">const</span> (</span><span class="line"><span class="ln">13</span>	topStories = <span class="tok-str">"https://hacker-news.firebaseio.com/v0/topstories.json"</span></span><span class="line"><span class="ln">14</span>	itemFormat = <span class="tok-str">"https://hacker-news.firebaseio.com/v0/item/%d.json"</span></span><span class="line"><span class="ln">15</span>	wanted     = <span class="tok-num">5</span></span><span class="line"><span class="ln">16</span>	budget     = <span class="tok-num">2</span> * time.Second</span><span class="line"><span class="ln">17</span>)</span><span class="line"><span class="ln">18</span></span><span class="line"><span class="ln">19</span><span class="tok-key">func</span> Top(request *http.Request) ([]Story, bool) {</span><span class="line"><span class="ln">20</span>	client := &amp;http.Client{Timeout: budget}</span><span class="line"><span class="ln">21</span>	<span class="tok-key">var</span> ids []int</span><span class="line"><span class="ln">22</span>	<span class="tok-key">if</span> err := read(request, client, topStories, &amp;ids); err != <span class="tok-key">nil</span> {</span><span class="line"><span class="ln">23</span>		<span class="tok-key">return</span> offline, false</span><span class="line"><span class="ln">24</span>	}</span><span class="line"><span class="ln">25</span>	stories := <span class="tok-key">make</span>([]Story, <span class="tok-num">0</span>, wanted)</span><span class="line"><span class="ln">26</span>	<span class="tok-key">for</span> _, id := <span class="tok-key">range</span> ids {</span><span class="line"><span class="ln">27</span>		<span class="tok-key">if</span> len(stories) == wanted {</span><span class="line"><span class="ln">28</span>			<span class="tok-key">break</span></span><span class="line"><span class="ln">29</span>		}</span><span class="line"><span class="ln">30</span>		<span class="tok-key">var</span> story Story</span><span class="line"><span class="ln">31</span>		<span class="tok-key">if</span> err := read(request, client, fmt.Sprintf(itemFormat, id), &amp;story); err != <span class="tok-key">nil</span> {</span><span class="line"><span class="ln">32</span>			<span class="tok-key">break</span></span><span class="line"><span class="ln">33</span>		}</span><span class="line"><span class="ln">34</span>		<span class="tok-key">if</span> story.Title == <span class="tok-str">""</span> {</span><span class="line"><span class="ln">35</span>			<span class="tok-key">continue</span></span><span class="line"><span class="ln">36</span>		}</span><span class="line"><span class="ln">37</span>		<span class="tok-key">if</span> story.URL == <span class="tok-str">""</span> {</span><span class="line"><span class="ln">38</span>			story.URL = fmt.Sprintf(<span class="tok-str">"https://news.ycombinator.com/item?id=%d"</span>, id)</span><span class="line"><span class="ln">39</span>		}</span><span class="line"><span class="ln">40</span>		stories = append(stories, story)</span><span class="line"><span class="ln">41</span>	}</span><span class="line"><span class="ln">42</span>	<span class="tok-key">if</span> len(stories) == <span class="tok-num">0</span> {</span><span class="line"><span class="ln">43</span>		<span class="tok-key">return</span> offline, false</span><span class="line"><span class="ln">44</span>	}</span><span class="line"><span class="ln">45</span>	<span class="tok-key">return</span> stories, true</span><span class="line"><span class="ln">46</span>}</span><span class="line"><span class="ln">47</span></span><span class="line"><span class="ln">48</span><span class="tok-key">func</span> read(request *http.Request, client *http.Client, url string, target any) error {</span><span class="line"><span class="ln">49</span>	outbound, err := http.NewRequestWithContext(request.Context(), http.MethodGet, url, <span class="tok-key">nil</span>)</span><span class="line"><span class="ln">50</span>	<span class="tok-key">if</span> err != <span class="tok-key">nil</span> {</span><span class="line"><span class="ln">51</span>		<span class="tok-key">return</span> err</span><span class="line"><span class="ln">52</span>	}</span><span class="line"><span class="ln">53</span>	response, err := client.Do(outbound)</span><span class="line"><span class="ln">54</span>	<span class="tok-key">if</span> err != <span class="tok-key">nil</span> {</span><span class="line"><span class="ln">55</span>		<span class="tok-key">return</span> err</span><span class="line"><span class="ln">56</span>	}</span><span class="line"><span class="ln">57</span>	<span class="tok-key">defer</span> <span class="tok-key">func</span>() { _ = response.Body.Close() }()</span><span class="line"><span class="ln">58</span>	<span class="tok-key">if</span> response.StatusCode != http.StatusOK {</span><span class="line"><span class="ln">59</span>		<span class="tok-key">return</span> fmt.Errorf(<span class="tok-str">"%s answered %d"</span>, url, response.StatusCode)</span><span class="line"><span class="ln">60</span>	}</span><span class="line"><span class="ln">61</span>	<span class="tok-key">return</span> json.NewDecoder(response.Body).Decode(target)</span><span class="line"><span class="ln">62</span>}</span></code></pre></div>
