<!doctype html>
<html lang="{{ locale.Tag }}" dir="{{ locale.Dir }}"<< if .Forced >> data-theme="<< .Forced >>"<< end >>>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/logo.svg" type="image/svg+xml">
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/sky.avif" as="image" type="image/avif" media="(min-width: 901px)">
    <link rel="preload" href="/sky-sm.avif" as="image" type="image/avif" media="(max-width: 900px)">
    {% meta %}
    {% assets %}
<< if .Toggle >>    <script>
        (() => {
            const stored = (() => {
                try {
                    return localStorage.getItem("theme");
                } catch {
                    return null;
                }
            })();
            if (stored === "light" || stored === "dark") {
                document.documentElement.dataset.theme = stored;
            }
        })();
    </script>
<< end >></head>
<body class="min-h-dvh">{% outlet %}</body>
</html>
