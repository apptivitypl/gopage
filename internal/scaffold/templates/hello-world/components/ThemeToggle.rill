---
type Props struct {
	Label string
}
---
<button class="switch" type="button" role="switch" :aria-label="Label">
    <span class="switch-knob" aria-hidden="true">
        <svg class="switch-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 1.8v2.4M12 19.8v2.4M1.8 12h2.4M19.8 12h2.4M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"/></svg>
        <svg class="switch-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.3A8.8 8.8 0 0 1 9.7 3.5a8.8 8.8 0 1 0 10.8 10.8Z"/></svg>
    </span>
</button>

<script client>
type Choice = "light" | "dark";

function stored(): Choice | null {
	try {
		const value = localStorage.getItem("theme");
		return value === "light" || value === "dark" ? value : null;
	} catch {
		return null;
	}
}

function remember(choice: Choice): boolean {
	try {
		localStorage.setItem("theme", choice);
		return true;
	} catch {
		return false;
	}
}

function shown(): Choice {
	const set = document.documentElement.dataset.theme;
	if (set === "light" || set === "dark") {
		return set;
	}
	return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
}

export function mount(element: HTMLElement): () => void {
	const button = element.querySelector("button");
	if (!button) {
		return () => {};
	}
	const mark = (choice: Choice) => button.setAttribute("aria-checked", String(choice === "dark"));
	mark(stored() ?? shown());

	const flip = () => {
		const next: Choice = shown() === "dark" ? "light" : "dark";
		remember(next);
		document.documentElement.dataset.theme = next;
		mark(next);
	};
	button.addEventListener("click", flip);
	return () => button.removeEventListener("click", flip);
}
</script>
