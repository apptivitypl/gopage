---
import (
	"time"

	"<<.Module>>/content"
)

type Props struct {
	Title   string
	Date    string
	Summary string
	Body    string
}

func Meta(ctx *gopage.Ctx, p Props) gopage.Meta {
	return gopage.Meta{Title: p.Title, Description: p.Summary, Robots: "index"}
}

func Load(ctx *gopage.Ctx, params gopage.Params) (Props, error) {
	post, err := content.Get(params["slug"])
	if err != nil {
		return Props{}, err
	}
	ctx.Cache().TTL(time.Hour).Tag("posts", "post:"+post.Slug)
	return Props{Title: post.Title, Date: post.Date, Summary: post.Summary, Body: post.Body}, nil
}
---
<article class="post">
    <h1>{{ Title }}</h1>
    <p class="meta">{{ Date }}</p>
    <p>{{ Body }}</p>
    <p><a href="/">{{ t("nav.home") }}</a></p>
</article>
