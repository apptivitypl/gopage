---
type Props struct {
	Heading string
}

func Meta(ctx *rill.Ctx, p Props) rill.Meta {
	return rill.Meta{Title: p.Heading, Robots: "noindex"}
}

func Load(ctx *rill.Ctx) (Props, error) {
	return Props{Heading: "something went wrong"}, nil
}
---
<h1>{{ Heading }}</h1>
<p>The page could not be rendered. <a href="/">Back to the start.</a></p>
