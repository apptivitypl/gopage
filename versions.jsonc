{
  "packages": {
    "gopage": {
      "kind": "go",
      "version": "0.2.1",
      "tag": "v{version}",
      "release": "goreleaser",
      "paths": [
        "*.go",
        "go.mod",
        "go.sum",
        "internal/**",
        "cmd/gopage/**",
        "schema/**",
        "install.sh",
        "install.ps1",
        "uninstall.sh",
        "uninstall.ps1",
        ".goreleaser.yml"
      ],
      "exclude": [
        "internal/tool/**"
      ]
    },

    "@apptivitypl/gopage": {
      "kind": "npm",
      "version": "0.2.1",
      "dir": "npm/gopage",
      "needs": ["gopage"],
      "paths": [
        "npm/gopage/**",
        "internal/tool/npmpkg/**"
      ]
    }
  }
}
