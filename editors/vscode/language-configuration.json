{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["{%", "%}"],
    ["{{", "}}"],
    ["<", ">"],
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    {"open": "{%", "close": " %}"},
    {"open": "{{", "close": " }}"},
    {"open": "{", "close": "}"},
    {"open": "(", "close": ")"},
    {"open": "[", "close": "]"},
    {"open": "\"", "close": "\"", "notIn": ["string"]},
    {"open": "'", "close": "'", "notIn": ["string"]},
    {"open": "<!--", "close": "-->", "notIn": ["comment", "string"]}
  ],
  "surroundingPairs": [
    ["{%", "%}"],
    ["{{", "}}"],
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"],
    ["<", ">"]
  ],
  "wordPattern": "(:?#?[A-Za-z_][A-Za-z0-9_-]*)",
  "indentationRules": {
    "increaseIndentPattern": "\\{%\\s*(if|elif|else|for|match|when|fragment|placeholder)\\b[^%]*%\\}\\s*$",
    "decreaseIndentPattern": "^\\s*\\{%\\s*(elif|else|endif|endfor|endmatch|endfragment|when|placeholder)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "\\{%\\s*(if|for|match|fragment)\\b[^%]*%\\}\\s*$",
      "action": {"indent": "indent"}
    },
    {
      "beforeText": "^\\s*\\{%\\s*(end(if|for|match|fragment))\\b[^%]*%\\}\\s*$",
      "action": {"indent": "outdent"}
    }
  ]
}
