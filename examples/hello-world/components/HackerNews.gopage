---
type Story struct {
	Title string
	URL   string
	By    string
	Score int
}

type Props struct {
	Stories []Story
}
---
<section class="hacker-news" aria-label="hacker news">
    <h3 class="hacker-news-title"><svg class="hacker-news-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M0 24V0h24v24H0zM6.951 5.896l4.112 7.708v5.064h1.583v-4.972l4.148-7.799h-1.749l-2.457 4.875c-.372.745-.688 1.434-.688 1.434s-.297-.708-.651-1.434L8.831 5.896z"/></svg>hacker news</h3>
    <ul class="stories" role="list">
    {% for story in Stories %}
        <li>
            <a class="mono story-link" :href="story.URL" rel="noreferrer">{{ story.Title }}</a>
            <span class="meta block">{{ story.Score }} points · {{ story.By }}</span>
        </li>
    {% else %}
        <li class="meta">hacker news is not answering</li>
    {% endfor %}
    </ul>
</section>
