{
  "$schema": "https://raw.githubusercontent.com/apptivitypl/rill/main/schema/rill.schema.json",

  // The name the worker is deployed under.
  "app": {"name": "hello-world"},

  // Languages, and how a request is mapped onto one. In "path" mode the
  // default locale has no prefix unless prefixDefault says otherwise.
  "i18n": {
    "mode": "path",
    "defaultLocale": "en",
    "locales": ["en"],
    "prefixDefault": false
  },

  // Prefixes the router refuses to give to a page.
  "routing": {
    "reserved": ["/api", "/_rill", "/robots.txt", "/sitemap.xml", "/favicon.ico", "/llms.txt"]
  },

  // A stylesheet smaller than inlineLimit is written into the document; anything
  // larger is served as its own cached file and preloaded in the early hints.
  // "0" links every stylesheet.
  "css": {"engine": "tailwind", "inlineLimit": "4kb"},

  // "partial" sends only the part of the document that changed.
  "nav": {"mode": "partial"},

  // How a deferred fragment reaches the page: the browser asks for it.
  "fragments": {"deferred": "fetch"},

  "client": {"react": "react"}
}
