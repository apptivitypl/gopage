---
type Props struct {
	Heading string
}

func Meta(ctx *rill.Ctx, p Props) rill.Meta {
	return rill.Meta{Title: p.Heading, Robots: "noindex"}
}

func Load(ctx *rill.Ctx) (Props, error) {
	return Props{Heading: ctx.T("missing.title")}, nil
}
---
<div class="shell">
<div class="card">
<main class="grid min-h-[60vh] place-items-center px-6 py-20 text-center">
    <div>
        <p class="badge">404</p>
        <h1 class="mt-6">{{ Heading }}</h1>
        <p class="mt-4 max-w-[46ch]" style="color: var(--color-ink-soft)">{{ t("missing.lead") }}</p>
        <p class="mt-8"><a class="action" href="/">{{ t("missing.back") }}</a></p>
    </div>
</main>
</div>
</div>
