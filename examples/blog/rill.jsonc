{
  "$schema": "https://raw.githubusercontent.com/apptivitypl/rill/main/schema/rill.schema.json",

  "app": {"name": "blog"},

  "i18n": {
    "mode": "path",
    "defaultLocale": "en",
    "locales": ["en"],
    "prefixDefault": false
  },

  "routing": {
    "reserved": ["/api", "/_rill", "/feed.xml", "/robots.txt", "/sitemap.xml", "/favicon.ico"]
  },

  "css": {"engine": "plain"},
  "nav": {"mode": "partial"}
}
