{
  "$schema": "https://raw.githubusercontent.com/apptivitypl/gopage/main/schema/gopage.schema.json",

  "app": {"name": "catalog"},

  "i18n": {
    "mode": "path",
    "defaultLocale": "en",
    "locales": ["en", "pl"],
    "prefixDefault": false
  },

  "routing": {
    "reserved": ["/api", "/_gopage", "/robots.txt", "/sitemap.xml", "/favicon.ico"]
  },

  "css": {"engine": "plain"},
  "nav": {"mode": "partial"}
}
