{
  "name": "rill",
  "image": "mcr.microsoft.com/devcontainers/go:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "24"}
  },
  "containerEnv": {
    "GOTOOLCHAIN": "auto",
    "CGO_ENABLED": "0"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {"label": "rill dev", "onAutoForward": "openPreview"}
  },
  "postCreateCommand": "go work init . examples/hello-world examples/blog && go mod download && corepack enable && pnpm install && (cd examples/hello-world && pnpm install) && go run ./cmd/rill css install",
  "postAttachCommand": "go run ./cmd/rill dev --dir examples/hello-world --addr 0.0.0.0:3000",
  "customizations": {
    "vscode": {"extensions": ["golang.go"]}
  }
}
