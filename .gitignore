# Test binaries left behind by `go test -c`. The pattern is anchored to a
# suffix rather than a name: an unanchored rule here once matched a source
# file and CI could not build the package that needed it.
*.test

# Compiled binaries of this repository's own commands.
/gopage
/gopagetool

# Coverage output, never committed.
/.coverage
coverage.html

# The workspace file the devcontainer writes to point the examples at this
# checkout. Committed examples require a published version instead.
/go.work
/go.work.sum

# Written into a committed example by any workers build.
/examples/*/wrangler.jsonc

# What a scaffolded project generates, for when one is created at this root.
/dist
/.gopage
/.wrangler

node_modules/
